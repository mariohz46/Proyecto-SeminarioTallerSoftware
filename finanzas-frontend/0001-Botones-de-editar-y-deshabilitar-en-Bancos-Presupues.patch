+
+.transaccion-container h2 {
+  margin: 0 0 1rem 0;
+  color: #38bdf8;
+  font-size: 1.4rem;
+}
+
+.fila {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 1rem;
+}
+
+@media (max-width: 640px) {
+  .fila {
+    grid-template-columns: 1fr;
